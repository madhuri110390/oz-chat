<!--                android:resource="@xml/sdk_provider_paths" />-->
<!--        </provider>-->

        <!-- Background sync -->
        <receiver
            android:name="im.vector.app.backgroundsync.receiver.AlarmSyncBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name="im.vector.app.backgroundsync.service.GuardAndroidService"
            android:enabled="false"
            tools:node="replace" />


