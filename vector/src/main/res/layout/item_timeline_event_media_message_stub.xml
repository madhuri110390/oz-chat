<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/messageImageCard"
        android:layout_width="wrap_content"
        app:rippleColor="@android:color/transparent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null"
        android:outlineAmbientShadowColor="@android:color/transparent"
        android:outlineSpotShadowColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.MaterialComponents.CardView"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        android:foreground="@null"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- messageContentMedia wraps thumbnail so holder.mediaContentView works -->
        <FrameLayout
            android:id="@+id/messageContentMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@null">

            <ImageView
                android:id="@+id/messageThumbnailView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:contentDescription="@string/a11y_image"
                tools:layout_height="300dp"
                tools:src="@tools:sample/backgrounds/scenic" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/messageMediaPlayView"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/action_play"
        android:src="@drawable/ic_material_play_circle"
        app:tint="@android:color/white"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/messageImageCard"
        app:layout_constraintEnd_toEndOf="@id/messageImageCard"
        app:layout_constraintStart_toStartOf="@id/messageImageCard"
        app:layout_constraintTop_toTopOf="@id/messageImageCard"
        tools:visibility="visible" />

