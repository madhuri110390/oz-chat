<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bubble_background_shape.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Transparent fill to let image show through -->
    <solid android:color="@android:color/transparent" />

    <!-- Define the border -->
    <stroke
        android:width="2dp"
        android:color="?attr/vctr_message_bubble_inbound" /> <!-- Or use hardcoded color -->

    <!-- Rounded corners -->
    <corners android:radius="12dp" />
</shape>


